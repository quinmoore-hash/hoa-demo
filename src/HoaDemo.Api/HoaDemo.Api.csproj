<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>HoaDemo.Api</RootNamespace>
    <AssemblyName>HoaDemo.Api</AssemblyName>
    <!-- Nullable stays off: with it on, non-nullable navigation properties become implicitly [Required]. -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.33" />
  </ItemGroup>

</Project>
