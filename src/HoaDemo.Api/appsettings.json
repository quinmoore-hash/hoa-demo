{
  // LocalDB is Windows-only. On Linux/macOS run SQL Server (e.g. in Docker) and override with
  // the ConnectionStrings__HoaContext environment variable.
  "ConnectionStrings": {
    "HoaContext": "Server=(localdb)\\MSSQLLocalDB;Database=HoaDemo;Integrated Security=True;MultipleActiveResultSets=True;TrustServerCertificate=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
